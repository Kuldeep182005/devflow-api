# =============================================================================
# DevFlow — Environment Variables Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY: .env is in .gitignore. NEVER commit real secrets.
# =============================================================================

# ---------- Database ----------
POSTGRES_DB=devflow
DATABASE_URL=jdbc:postgresql://localhost:5432/devflow
DATABASE_USERNAME=devflow
DATABASE_PASSWORD=change-me

# ---------- Authentication ----------
# Use a random, at least 32-byte secret in non-development environments.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION=15m
PASSWORD_BCRYPT_STRENGTH=12

# ---------- GitHub App ----------
# GitHub App credentials are read at runtime and never stored in the database.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_BASE_URL=https://api.github.com
GITHUB_CONNECT_TIMEOUT=5s
GITHUB_READ_TIMEOUT=10s
GITHUB_MAX_RESPONSE_BYTES=1048576

# ---------- GitHub Webhook ----------
# HMAC secret for webhook verification; keep separate from App credentials.
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576

# ---------- Sandbox Executor ----------
# Shared authentication token between API and sandbox executor.
SANDBOX_EXECUTOR_TOKEN=replace-with-a-long-random-sandbox-token
SANDBOX_EXECUTOR_URL=http://localhost:8089

# ---------- LLM Provider ----------
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---------- Server ----------
SERVER_PORT=8080
EXECUTOR_PORT=8089
SPRING_PROFILES_ACTIVE=local

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
